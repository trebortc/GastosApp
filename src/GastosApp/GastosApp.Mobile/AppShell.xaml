<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GastosApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GastosApp.Mobile.Views"
    Title="GastosApp">

    <!-- Ruta de autenticacion (sin tab bar) -->
    <ShellContent
        x:Name="LoginShell"
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.NavBarIsVisible="False" />

    <!-- Tabs principales (post-login) -->
    <TabBar x:Name="MainTabs" Route="main">
        <Tab Title="Resumen" Icon="chart_icon.png">
            <ShellContent
                Route="dashboard"
                ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Gastos" Icon="expense_icon.png">
            <ShellContent
                Route="expenses"
                ContentTemplate="{DataTemplate views:ExpensesPage}" />
        </Tab>
        <Tab Title="Categorias" Icon="category_icon.png">
            <ShellContent
                Route="categories"
                ContentTemplate="{DataTemplate views:CategoriesPage}" />
        </Tab>
    </TabBar>

</Shell>
